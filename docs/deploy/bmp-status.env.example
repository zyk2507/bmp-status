# Copy to bmp-status.env (chmod 600) before using podman compose or Quadlet.
# Values below are passed directly to the container environment.

# Required by the sample compose file. At least 8 characters.
# NOTE: setting this resets the page password on every container start.
# Remove it if you prefer the generated page password in
# /var/lib/bmp-status/initial-admin-password.txt (read it with podman exec).
ADMIN_PASSWORD=change-me-to-a-long-password

# Set true only when the dashboard/admin is behind an HTTPS reverse proxy.
COOKIE_SECURE=false

# Log verbosity; use debug only while troubleshooting.
RUST_LOG=bmp_status=info

# Optional overrides (defaults shown):
# BMP_BIND=0.0.0.0:11019
# HTTP_BIND=0.0.0.0:8787
# DATA_DIR=/var/lib/bmp-status
# TZ=Asia/Shanghai
