# Rust
backend/target/
tools/ripe-replay/target/

# Build artifacts (created only after successful builds)
/bin/
/prebuilt-images/
/.build.env

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/out/

# Runtime data (password hash, instance registry, initial password)
/data/
/data-*/
.env
.env.local

# Container deployment secrets (keep the .example file tracked)
docs/deploy/bmp-status.env

# RIPE RIS data: historical MRT/BGP archives and local cache.
# Never commit downloaded routing archives; they are large and can be re-fetched.
**/ripe-cache/
updates.*.gz
bview.*.gz
*.mrt
*.mrt.gz
*.mrt.bz2
*.mrt.zst

# OS / editor
.DS_Store
*.log

# Generated by Next.js dev tooling
frontend/AGENTS.md
*.tsbuildinfo

# Local E2E workspace (RustyBGP checkout, logs, route snapshots)
/.cache/
